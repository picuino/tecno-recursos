# HELP
#   object: dependencies
#   $@ object
#   $^ dependencies
#   $^ first element of dependencies list

IMGDIR=_images
THUMBDIR=_thumbs
STATICDIR=../../_static

JOINPDF=gswin32.exe -dNOPAUSE -q -sDEVICE=pdfwrite
PDFTOPNG=pdftopng -cfg /Bin/xpdf/.xpdfrc -r 600 -aa yes -aaVector yes -freetype yes
OPTIPNG=optipng -quiet -o 6
CONVERT=convert
MOGRIFY=mogrify
ZIP=7z a -x!*bak*


# --------------------------------------------------------------------
# macros
#
define pdf_page_to_png
	$(PDFTOPNG) $(1).pdf $(IMGDIR)/$(1)
	mv -f $(IMGDIR)/$(1)-000001.png  $(IMGDIR)/$(1).png
	$(MOGRIFY) -posterize 16 $(IMGDIR)/$(1).png
	$(OPTIPNG) $(IMGDIR)/$(1).png
endef

# crop_image,image.png,suffix,size,sign
define crop_image
	$(eval size=$(shell python3 -c "import sys; \
	(x0,y0),(x1,y1)=eval(sys.argv[1]); \
	print('%dx%d+%d+%d'%(abs(x0-x1),abs(y0-y1), \
	min(x0,x1), min(y0,y1)));" $(3)))
	$(CONVERT) $(1) -crop $(size) +repage $(4) $(basename $(1))-$(2).png
	$(OPTIPNG) $(basename $(1))-$(2).png
endef

# crop_lamina, source, sign
define crop_lamina
	$(call crop_image,$(1),f1,"(( 302,  444), (2484, 2531))", $(2))
	$(call crop_image,$(1),f2,"((2476,  444), (4657, 2531))", $(2))
	$(call crop_image,$(1),f3,"(( 302, 2523), (2484, 4610))", $(2))
	$(call crop_image,$(1),f4,"((2476, 2523), (4657, 4610))", $(2))
	$(call crop_image,$(1),f5,"(( 302, 4602), (2484, 6689))", $(2))
	$(call crop_image,$(1),f6,"((2476, 4602), (4657, 6689))", $(2))
endef


# --------------------------------------------------------------------
# dibujo-vistas-perspectivas
#
$(IMGDIR)/dibujo-vistas-perspectivas.png: dibujo-vistas-perspectivas.pdf
	$(call pdf_page_to_png,$(basename $^))

dibujo-vistas-perspectivas-images=\
	$(foreach f, f1 f2 f3 f4 f5 f6, $(IMGDIR)/dibujo-vistas-perspectivas-$(f).png)

$(dibujo-vistas-perspectivas-images): $(IMGDIR)/dibujo-vistas-perspectivas.png
	$(call crop_lamina, $^, $(SIGN_DER))


.PHONY: dibujo-vistas-perspectivas  clean-dibujo-vistas-perspectivas
dibujo-vistas-perspectivas: \
	$(IMGDIR)/dibujo-vistas-perspectivas.png \
	$(dibujo-vistas-perspectivas-images) \


clean-dibujo-vistas-perspectivas:
	rm -f $(IMGDIR)/dibujo-vistas-perspectivas.png
	rm -f $(dibujo-vistas-perspectivas-images)


